# Generic dashboard database credentials. Use a dedicated account.
DB_HOST=database.example.internal
DB_PORT=3306
DB_USER=dashboard_service_user
DB_PASSWORD=replace_with_secret
DB_NAME=rca_database

# Explicit browser origins; comma-separate additional environments.
CORS_ORIGINS=http://localhost:5173

# Prototype identity. Replace this with company SSO before wider deployment.
DEV_USER_NAME=Prototype Engineer
DEV_USER_ROLE=engineer
